# StreamPulse public defaults. Do not put credentials or production endpoints here.
STREAM_PULSE_ENV=local
STREAM_PULSE_DATASET=synthetic

# Local-only defaults. Replace them before exposing either service.
CLICKHOUSE_PASSWORD=streampulse-local
GRAFANA_CH_PASSWORD=grafana-local
GRAFANA_ADMIN_PASSWORD=admin

# Recommendation API local guardrails.
HISTORY_WINDOWS=15
MINIMUM_HISTORY_WINDOWS=5
MINIMUM_SAMPLES=100
METRICS_STALE_AFTER=2m
RECOMMENDATION_TTL=2m
MINIMUM_DWELL=1m
MAXIMUM_WEIGHT_STEP=0.20
SATURATION_LIMIT=0.85
